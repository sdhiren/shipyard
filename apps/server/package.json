{
  "name": "@shipyard/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run build -w @shipyard/shared",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.7",
    "@shipyard/shared": "0.1.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "nanoid": "^5.1.6",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "vitest": "^5.0.5"
  }
}
